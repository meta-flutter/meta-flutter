From 817aeec957811882c7245303b3023fcb34081d0b Mon Sep 17 00:00:00 2001
From: Joel Winarske <joel.winarske@gmail.com>
Date: Thu, 27 Aug 2026 18:26:56 -0700
Subject: [PATCH] Recognize arm on desktop Linux

The Linux architecture check knows only x86 and x86_64, so a build for any
other architecture stops at "#error Unknown Linux architecture" -- which for
Linux on arm is a build the SDK otherwise supports: the desktop stack is
architecture-neutral, and the string this decides only names the platform in
the user agent the SDK reports.

Name arm64 and arm the way the other platforms in this file already do
(Android uses the same values), and leave the error in place for anything
genuinely unrecognized.
Upstream-Status: Pending

Carried by firebase_ffi, where the set is maintained:
https://github.com/jwinarske/firebase_ffi/tree/main/packages/firebase_ffi/patches/firebase-cpp-sdk
---
 app/src/app_common.cc | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/app/src/app_common.cc b/app/src/app_common.cc
index d752bce..6215183 100644
--- a/app/src/app_common.cc
+++ b/app/src/app_common.cc
@@ -155,6 +155,10 @@ const char* kCppRuntimeOrStl = "libcpp";
 const char* kCpuArchitecture = "x86_64";
 #elif __i386__
 const char* kCpuArchitecture = "x86";
+#elif __aarch64__
+const char* kCpuArchitecture = "arm64";
+#elif __arm__
+const char* kCpuArchitecture = "arm";
 #else
 #error Unknown Linux architecture.
 #endif  // Architecture
