+namespace {
+
+// Builds the one-aggregation query the public Sum and Average return.
+//
+// The core already carries aggregations end to end -- api::Query::Aggregate,
+// FirestoreClient::RunAggregateQuery and the serializer all take a vector of
+// model::AggregateField. Only the public API was missing.
+AggregateQuery MakeAggregate(const api::Query& query,
+                             model::AggregateField::OpKind op,
+                             const char* alias,
+                             const std::string& field) {
+  std::vector<model::AggregateField> fields;
+  fields.emplace_back(op, model::AggregateAlias(alias),
+                      model::FieldPath::FromDotSeparatedString(field));
+  AggregateQueryInternal internal{query.Aggregate(std::move(fields)), alias};
+  return MakePublic(std::move(internal));
+}
+
+}  // namespace
+
+AggregateQuery QueryInternal::Sum(const std::string& field) {
+  return MakeAggregate(query_, model::AggregateField::OpKind::Sum, kSumAlias,
+                       field);
+}
+
+AggregateQuery QueryInternal::Average(const std::string& field) {
+  return MakeAggregate(query_, model::AggregateField::OpKind::Avg,
+                       kAverageAlias, field);
+}
