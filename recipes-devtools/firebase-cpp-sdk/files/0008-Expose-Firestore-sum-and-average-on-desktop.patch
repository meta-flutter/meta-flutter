diff --git a/firestore/src/main/aggregate_query_main.cc b/firestore/src/main/aggregate_query_main.cc
index 3250f7d..0cae667 100644
--- a/firestore/src/main/aggregate_query_main.cc
+++ b/firestore/src/main/aggregate_query_main.cc
@@ -36,6 +36,37 @@ AggregateQueryInternal::AggregateQueryInternal(
     : aggregate_query_{std::move(aggregate_query)},
       promise_factory_{PromiseFactory<AsyncApis>::Create(this)} {}
 
+AggregateQueryInternal::AggregateQueryInternal(
+    api::AggregateQuery&& aggregate_query, std::string alias)
+    : aggregate_query_{std::move(aggregate_query)},
+      promise_factory_{PromiseFactory<AsyncApis>::Create(this)},
+      alias_{std::move(alias)} {}
+
+namespace {
+
+// Reads one aggregation out of the response.
+//
+// The backend answers a sum with an integer when every input was an integer
+// and a double otherwise, so both have to be accepted -- taking only the
+// double would read an integer sum as zero. Anything else, including a missing
+// alias, is an empty result set: there was nothing to aggregate, not a
+// value of zero that someone stored.
+double ReadAggregate(const model::ObjectValue& fields,
+                     const std::string& alias) {
+  const absl::optional<google_firestore_v1_Value> value = fields.Get(alias);
+  if (!value.has_value()) return 0.0;
+  switch (value->which_value_type) {
+    case google_firestore_v1_Value_integer_value_tag:
+      return static_cast<double>(value->integer_value);
+    case google_firestore_v1_Value_double_value_tag:
+      return value->double_value;
+    default:
+      return 0.0;
+  }
+}
+
+}  // namespace
+
 FirestoreInternal* AggregateQueryInternal::firestore_internal() {
   return GetFirestoreInternal(&aggregate_query_.query());
 }
@@ -53,6 +84,27 @@ Future<AggregateQuerySnapshot> AggregateQueryInternal::Get(
   api::AggregateQuery aggregate_query = aggregate_query_;
   auto promise =
       promise_factory_.CreatePromise<AggregateQuerySnapshot>(AsyncApis::kGet);
+
+  // A named aggregation reads its result out of the response by alias. Count
+  // keeps the core's count-specific path, which is the one the SDK has always
+  // used and the one its tests cover.
+  if (!alias_.empty()) {
+    const std::string alias = alias_;
+    aggregate_query_.GetAggregate(
+        [aggregate_query, promise,
+         alias](const util::StatusOr<model::ObjectValue>& maybe_value) mutable {
+          if (!maybe_value.ok()) {
+            promise.SetError(maybe_value.status());
+            return;
+          }
+          AggregateQuerySnapshotInternal internal{
+              std::move(aggregate_query),
+              ReadAggregate(maybe_value.ValueOrDie(), alias)};
+          promise.SetValue(MakePublic(std::move(internal)));
+        });
+    return promise.future();
+  }
+
