--- a/packages/flutter_tools/lib/src/artifacts.dart
+++ b/packages/flutter_tools/lib/src/artifacts.dart
@@ -213,6 +213,7 @@ TargetPlatform? _mapTargetPlatform(TargetPlatform? targetPlatform) {
     case TargetPlatform.linux_x64:
     case TargetPlatform.linux_arm64:
     case TargetPlatform.linux_riscv64:
+    case TargetPlatform.linux_arm:
     case TargetPlatform.windows_x64:
     case TargetPlatform.windows_arm64:
     case TargetPlatform.fuchsia_arm64:
@@ -435,6 +436,7 @@ class CachedArtifacts implements Artifacts {
       case TargetPlatform.linux_x64:
       case TargetPlatform.linux_arm64:
       case TargetPlatform.linux_riscv64:
+      case TargetPlatform.linux_arm:
       case TargetPlatform.windows_x64:
       case TargetPlatform.windows_arm64:
         return _getDesktopArtifactPath(artifact, platform!, mode);
@@ -789,6 +791,7 @@ class CachedArtifacts implements Artifacts {
       case TargetPlatform.linux_x64:
       case TargetPlatform.linux_arm64:
       case TargetPlatform.linux_riscv64:
+      case TargetPlatform.linux_arm:
       case TargetPlatform.darwin:
       case TargetPlatform.windows_x64:
       case TargetPlatform.windows_arm64:
@@ -1598,6 +1601,7 @@ String _getPrebuiltTarget(Platform platform, OperatingSystemUtils operatingSyste
     case TargetPlatform.fuchsia_x64:
     case TargetPlatform.web_javascript:
     case TargetPlatform.tester:
+    case TargetPlatform.linux_arm:
       throwToolExit('Unsupported host platform: $hostPlatform');
     case TargetPlatform.unsupported:
       TargetPlatform.throwUnsupportedTarget();
diff --git a/packages/flutter_tools/lib/src/base/build.dart b/packages/flutter_tools/lib/src/base/build.dart
index 8c724e6..1b2a4a0 100644
