From 6a2d91dac4363720108b889cd7c03b2216124289 Mon Sep 17 00:00:00 2001
From: Joel Winarske <joel.winarske@gmail.com>
Date: Thu, 5 Nov 2026 07:22:14 +1100
Subject: [PATCH] flutter_tools: add linux-arm target platform

-TargetPlatform.linux_arm, accepted by flutter build bundle
-native assets map to Architecture.arm, manifest keyed linux_arm
-custom devices accept linux-arm
-not a host platform, artifacts and build linux unchanged

Upstream-Status: Pending

Signed-off-by: Joel Winarske <joel.winarske@gmail.com>
---
 .../flutter_tools/lib/src/android/android_device.dart  |  2 ++
 packages/flutter_tools/lib/src/artifacts.dart          |  4 ++++
 packages/flutter_tools/lib/src/base/build.dart         |  1 +
 packages/flutter_tools/lib/src/build_info.dart         |  6 +++++-
 .../lib/src/build_system/targets/common.dart           |  2 ++
 .../lib/src/build_system/tools/shader_compiler.dart    |  1 +
 packages/flutter_tools/lib/src/commands/assemble.dart  |  3 +++
 .../flutter_tools/lib/src/commands/build_bundle.dart   |  1 +
 .../lib/src/custom_devices/custom_device_config.dart   | 10 ++++++----
 .../lib/src/flutter_application_package.dart           |  1 +
 .../lib/src/isolated/native_assets/native_assets.dart  |  1 +
 .../lib/src/isolated/native_assets/targets.dart        |  3 +++
 packages/flutter_tools/lib/src/mdns_discovery.dart     |  1 +
 packages/flutter_tools/lib/src/resident_runner.dart    |  1 +
 .../flutter_tools/lib/src/runner/flutter_command.dart  |  1 +
 15 files changed, 33 insertions(+), 5 deletions(-)

